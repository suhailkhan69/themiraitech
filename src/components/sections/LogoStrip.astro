---
const logos = [
  { name: 'Acme Legal', width: 100 },
  { name: 'Vertex Realty', width: 120 },
  { name: 'ClearSmile Dental', width: 110 },
  { name: 'ShopEdge', width: 95 },
  { name: 'ProHome Services', width: 115 },
  { name: 'NorthStar Group', width: 105 },
];
---

<section class="py-16 border-y border-border">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="text-center text-text-muted text-sm mb-10 tracking-wider uppercase">
      Trusted by businesses across the US, UK, Canada & Australia
    </p>
    <div class="flex flex-wrap items-center justify-center gap-10 lg:gap-16">
      {logos.map(logo => (
        <div
          class="flex items-center justify-center opacity-30 hover:opacity-50 transition-opacity"
          style={`width: ${logo.width}px`}
        >
          <!-- Placeholder logo text — replace with actual <img> tags -->
          <span class="font-heading font-semibold text-text-secondary text-sm tracking-tight whitespace-nowrap">
            {logo.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
