---
const services = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>`,
    title: 'AI Voice Agents',
    description: 'Never miss a call again. Our AI voice agents handle inbound inquiries, qualify leads, book appointments, and answer FAQs – 24/7, at scale.',
    stat: '3× more calls handled',
    href: '/services#voice-agents',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`,
    title: 'Workflow Automation',
    description: 'Connect your CRM, email, calendar, and backend tools into a single automated machine. Built with n8n, Make, and custom APIs.',
    stat: '15hrs/week saved on average',
    href: '/services#workflow-automation',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>`,
    title: 'Custom AI Chatbots & RAG',
    description: 'AI assistants trained on your documents, products, and policies. Deploy on your website, WhatsApp, or internal tools.',
    stat: '80% support ticket deflection',
    href: '/services#chatbots',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>`,
    title: 'AI Lead Generation',
    description: 'Automated outreach, qualification, and nurturing systems that fill your pipeline while you focus on closing.',
    stat: '342% more qualified leads',
    href: '/services#lead-generation',
  },
];
---

<section class="py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="section-label mb-4">What we build</div>
      <h2 class="font-heading text-4xl sm:text-5xl font-bold text-text-primary mb-4">
        AI that does the work.<br />You do the strategy.
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Four core systems that remove bottlenecks, cut costs, and compound over time.
      </p>
    </div>

    <!-- Service cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service, i) => (
        <a
          href={service.href}
          class="group relative rounded-xl border border-border bg-surface p-8 transition-all duration-300 hover:border-accent-indigo/40 hover:bg-surface-2 overflow-hidden"
        >
          <!-- Hover glow -->
          <div class="absolute inset-0 bg-gradient-card opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

          <div class="relative">
            <!-- Icon -->
            <div class="w-12 h-12 rounded-xl bg-surface-2 border border-border flex items-center justify-center text-accent-indigo mb-6 group-hover:border-accent-indigo/40 transition-colors">
              <Fragment set:html={service.icon} />
            </div>

            <h3 class="font-heading text-xl font-semibold text-text-primary mb-3">
              {service.title}
            </h3>
            <p class="text-text-secondary text-sm leading-relaxed mb-6">
              {service.description}
            </p>

            <!-- Stat -->
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-semibold text-accent-cyan">
                {service.stat}
              </span>
              <svg class="w-4 h-4 text-text-muted group-hover:text-accent-indigo group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12">
      <a href="/services" class="btn-secondary">
        View all services
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
