---
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-accent-indigo/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/4 w-[300px] h-[300px] bg-accent-violet/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Decorative grid -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
    style="background-image: linear-gradient(#6366F1 1px, transparent 1px), linear-gradient(to right, #6366F1 1px, transparent 1px); background-size: 60px 60px;">
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 text-center">
    <!-- Section label -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent-indigo/30 bg-accent-indigo/10 text-accent-indigo text-xs font-medium tracking-wider uppercase mb-8 animate-fade-in">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-indigo animate-pulse"></span>
      AI Automation Agency
    </div>

    <!-- Headline -->
    <h1 class="font-heading text-5xl sm:text-6xl lg:text-7xl font-bold text-text-primary leading-[1.05] tracking-tight mb-6 animate-slide-up">
      AI systems that<br />
      <span class="bg-gradient-primary bg-clip-text text-transparent">actually ship.</span>
    </h1>

    <!-- Subhead -->
    <p class="text-text-secondary text-lg sm:text-xl max-w-2xl mx-auto mb-10 leading-relaxed animate-slide-up" style="animation-delay: 0.1s">
      We build AI voice agents, workflow automation, and custom AI systems for Western SMBs — deployed in days, not months.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 0.2s">
      <a href="/contact" class="btn-primary text-base px-8 py-4">
        Book a free strategy call
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="/case-studies" class="btn-secondary text-base px-8 py-4">
        See case studies
      </a>
    </div>

    <!-- Social proof bar -->
    <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-8 text-text-muted text-sm animate-fade-in" style="animation-delay: 0.4s">
      <div class="flex items-center gap-2">
        <div class="flex -space-x-1">
          {[...Array(5)].map(() => (
            <div class="w-6 h-6 rounded-full bg-gradient-primary border-2 border-background"></div>
          ))}
        </div>
        <span>50+ businesses automated</span>
      </div>
      <div class="hidden sm:block w-px h-4 bg-border"></div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span>4.9/5 average satisfaction</span>
      </div>
      <div class="hidden sm:block w-px h-4 bg-border"></div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span>Average 5-day deployment</span>
      </div>
    </div>
  </div>
</section>
