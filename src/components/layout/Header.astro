---
const navLinks = [
  { label: 'Services', href: '/services' },
  { label: 'Solutions', href: '/solutions' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];

const pathname = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-gradient-primary flex items-center justify-center">
          <span class="text-white font-bold text-sm font-heading">M</span>
        </div>
        <span class="font-heading font-semibold text-text-primary text-lg tracking-tight">
          mirai
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-150 ${
              pathname === link.href || pathname.startsWith(link.href + '/')
                ? 'text-text-primary bg-surface-2'
                : 'text-text-secondary hover:text-text-primary hover:bg-surface'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA + Mobile toggle -->
      <div class="flex items-center gap-3">
        <a href="/contact" class="hidden md:inline-flex btn-primary text-sm py-2 px-4">
          Book a call
        </a>
        <button
          id="mobile-menu-toggle"
          class="md:hidden p-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-surface transition-colors"
          aria-label="Open menu"
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-border bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-4 space-y-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="block px-4 py-2 rounded-lg text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-surface-2 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-2 border-t border-border mt-2">
        <a href="/contact" class="btn-primary w-full justify-center">
          Book a call
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('bg-background/90', 'backdrop-blur-md', 'border-b', 'border-border');
    } else {
      header?.classList.remove('bg-background/90', 'backdrop-blur-md', 'border-b', 'border-border');
    }
  }, { passive: true });

  // Mobile menu
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });
</script>
