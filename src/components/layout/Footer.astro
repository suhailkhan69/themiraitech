---
import Logo from '@/components/ui/Logo';
const year = new Date().getFullYear();

const links = {
  Services: [
    { label: 'AI Voice Agents', href: '/services#voice-agents' },
    { label: 'Workflow Automation', href: '/services#workflow-automation' },
    { label: 'AI Chatbots & RAG', href: '/services#chatbots' },
    { label: 'AI Lead Generation', href: '/services#lead-generation' },
  ],
  Solutions: [
    { label: 'Real Estate', href: '/solutions/real-estate' },
    { label: 'Legal Firms', href: '/solutions/legal' },
    { label: 'Dental & Medical', href: '/solutions/dental-medical' },
    { label: 'E-commerce', href: '/solutions/ecommerce' },
    { label: 'Home Services', href: '/solutions/home-services' },
  ],
  Company: [
    { label: 'About', href: '/about' },
    { label: 'Case Studies', href: '/case-studies' },
    { label: 'Blog', href: '/blog' },
    { label: 'Contact', href: '/contact' },
  ],
  Legal: [
    { label: 'Privacy Policy', href: '/privacy' },
    { label: 'Terms of Service', href: '/terms' },
  ],
};
---

<footer class="border-t border-border bg-surface mt-auto">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 lg:gap-12">
      <!-- Brand column -->
      <div class="col-span-2">
        <a href="/" class="flex items-center mb-4">
          <Logo size={26} showWordmark={true} client:load />
        </a>
        <p class="text-text-secondary text-sm leading-relaxed mb-6 max-w-xs">
          AI systems that ship. Built for teams that can't afford to experiment.
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-3">
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg border border-border flex items-center justify-center text-text-muted hover:text-text-primary hover:border-accent-indigo/50 transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href="https://twitter.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg border border-border flex items-center justify-center text-text-muted hover:text-text-primary hover:border-accent-indigo/50 transition-colors"
            aria-label="X / Twitter"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a
            href="https://youtube.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg border border-border flex items-center justify-center text-text-muted hover:text-text-primary hover:border-accent-indigo/50 transition-colors"
            aria-label="YouTube"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {Object.entries(links).map(([title, items]) => (
        <div>
          <h3 class="text-text-primary text-sm font-semibold mb-4">{title}</h3>
          <ul class="space-y-3">
            {items.map(item => (
              <li>
                <a
                  href={item.href}
                  class="text-text-muted text-sm hover:text-text-primary transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-text-muted text-sm">
        &copy; {year} Mirai Technology. All rights reserved.
      </p>
      <p class="text-text-muted text-sm">
        Based in India. Serving globally.
      </p>
    </div>
  </div>
</footer>
