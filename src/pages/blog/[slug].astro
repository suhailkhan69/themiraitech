---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Related posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

const pageUrl = `https://themiraitech.com/blog/${post.id}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.pubDate.toISOString(),
      "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      "url": pageUrl,
      "inLanguage": "en-US",
      "keywords": post.data.tags.join(', '),
      "articleSection": post.data.category,
      ...(post.data.readingTime ? { "timeRequired": `PT${post.data.readingTime}M` } : {}),
      "author": {
        "@type": "Organization",
        "@id": "https://themiraitech.com/#organization",
        "name": "Mirai Team",
        "url": "https://themiraitech.com"
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://themiraitech.com/#organization",
        "name": "Mirai",
        "logo": {
          "@type": "ImageObject",
          "url": "https://themiraitech.com/logo.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "isPartOf": {
        "@type": "Blog",
        "@id": "https://themiraitech.com/blog#blog",
        "name": "Mirai Blog",
        "url": "https://themiraitech.com/blog"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://themiraitech.com" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://themiraitech.com/blog" },
        { "@type": "ListItem", "position": 3, "name": post.data.title, "item": pageUrl }
      ]
    }
  ]
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalURL={pageUrl}
  schema={articleSchema}
>
  <!-- Breadcrumb -->
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8">
    <ol class="flex items-center gap-2 text-sm text-text-muted">
      <li><a href="/" class="hover:text-text-primary transition-colors">Home</a></li>
      <li>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li><a href="/blog" class="hover:text-text-primary transition-colors">Blog</a></li>
      <li>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li class="text-text-primary truncate max-w-[200px]">{post.data.title}</li>
    </ol>
  </nav>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-12">
      <!-- Main content -->
      <article>
        <!-- Header -->
        <header class="mb-10">
          <div class="flex items-center gap-3 mb-6">
            <Badge variant="accent">{post.data.category}</Badge>
            {post.data.tags.slice(0, 2).map(tag => (
              <Badge variant="default">{tag}</Badge>
            ))}
          </div>
          <h1 class="font-heading text-4xl sm:text-5xl font-bold text-text-primary mb-6 leading-tight">
            {post.data.title}
          </h1>
          <p class="text-text-secondary text-xl leading-relaxed mb-8">
            {post.data.description}
          </p>
          <div class="flex items-center gap-6 pb-8 border-b border-border">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-primary flex items-center justify-center">
                <span class="text-white font-semibold text-sm">M</span>
              </div>
              <div>
                <p class="text-text-primary text-sm font-medium">{post.data.author}</p>
                <p class="text-text-muted text-xs">{formatDate(post.data.pubDate)}</p>
              </div>
            </div>
            {post.data.readingTime && (
              <span class="text-text-muted text-sm">{post.data.readingTime} min read</span>
            )}
          </div>
        </header>

        <!-- MDX content -->
        <div class="prose prose-invert prose-lg max-w-none">
          <Content />
        </div>

        <!-- Author card -->
        <div class="mt-12 rounded-xl border border-border bg-surface p-6 flex items-start gap-5">
          <div class="w-14 h-14 rounded-full bg-gradient-primary flex items-center justify-center flex-shrink-0">
            <span class="text-white font-bold text-lg">M</span>
          </div>
          <div>
            <p class="text-text-primary font-semibold mb-1">Written by {post.data.author}</p>
            <p class="text-text-secondary text-sm leading-relaxed">
              The Mirai team builds AI automation systems for Western SMBs. We write about what we're building, what we're learning, and what's actually working.
            </p>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <!-- Table of contents -->
        {headings.length > 0 && (
          <div class="sticky top-24 rounded-xl border border-border bg-surface p-6">
            <h3 class="font-heading text-sm font-semibold text-text-primary mb-4 uppercase tracking-wider">
              Contents
            </h3>
            <nav>
              <ul class="space-y-2">
                {headings.filter(h => h.depth <= 3).map(heading => (
                  <li style={`padding-left: ${(heading.depth - 2) * 12}px`}>
                    <a
                      href={`#${heading.slug}`}
                      class="text-text-muted text-sm hover:text-text-primary transition-colors block py-1"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )}

        <!-- CTA -->
        <div class="rounded-xl border border-accent-indigo/20 bg-accent-indigo/5 p-6 text-center">
          <p class="font-heading font-semibold text-text-primary mb-2">Ready to automate?</p>
          <p class="text-text-secondary text-sm mb-4">
            Book a free strategy call and we'll map out the best AI opportunity for your business.
          </p>
          <a href="/contact" class="btn-primary w-full justify-center text-sm">
            Book a call
          </a>
        </div>
      </aside>
    </div>

    <!-- Related posts -->
    {related.length > 0 && (
      <div class="mt-20 pt-12 border-t border-border">
        <h2 class="font-heading text-2xl font-bold text-text-primary mb-8">Related articles</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map(p => (
            <a
              href={`/blog/${p.id}`}
              class="group rounded-xl border border-border bg-surface p-6 hover:border-accent-indigo/30 transition-all"
            >
              <Badge variant="default" class="mb-4">{p.data.category}</Badge>
              <h3 class="font-heading text-base font-semibold text-text-primary mb-2 group-hover:text-accent-indigo transition-colors leading-snug">
                {p.data.title}
              </h3>
              <p class="text-text-secondary text-sm line-clamp-2">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
