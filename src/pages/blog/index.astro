---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Badge from '@/components/ui/Badge.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['All', 'AI Automation', 'Case Studies', 'Industry Guides', 'Tutorials'];

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const featured = posts.find(p => p.data.featured);
const rest = posts.filter(p => !p.data.featured || p !== featured);
---

<BaseLayout
  title="Blog | Mirai"
  description="Practical guides, case studies, and tutorials on AI automation for SMBs. Learn how to deploy AI voice agents, workflow automation, and more."
>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-label mb-4">Blog</div>
      <h1 class="font-heading text-5xl sm:text-6xl font-bold text-text-primary mb-6">
        AI automation, explained.
      </h1>
      <p class="text-text-secondary text-xl max-w-2xl mx-auto">
        Practical guides, case studies, and real-world insights on deploying AI in your business — no hype, no fluff.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Featured post -->
      {featured && (
        <div class="mb-16">
          <p class="text-text-muted text-xs uppercase tracking-wider mb-6 font-semibold">Featured</p>
          <a
            href={`/blog/${featured.id}`}
            class="group grid grid-cols-1 lg:grid-cols-2 gap-8 rounded-2xl border border-border bg-surface p-8 hover:border-accent-indigo/30 transition-all"
          >
            <div>
              <div class="flex items-center gap-3 mb-4">
                <Badge variant="accent">{featured.data.category}</Badge>
                <span class="text-text-muted text-sm">{formatDate(featured.data.pubDate)}</span>
              </div>
              <h2 class="font-heading text-2xl font-bold text-text-primary mb-4 group-hover:text-accent-indigo transition-colors leading-snug">
                {featured.data.title}
              </h2>
              <p class="text-text-secondary leading-relaxed mb-6">
                {featured.data.description}
              </p>
              <div class="flex items-center gap-4 text-sm text-text-muted">
                <span>{featured.data.author}</span>
                {featured.data.readingTime && (
                  <>
                    <span>·</span>
                    <span>{featured.data.readingTime} min read</span>
                  </>
                )}
              </div>
            </div>
            <div class="rounded-xl bg-surface-2 border border-border flex items-center justify-center min-h-[200px]">
              <div class="text-center">
                <div class="w-16 h-16 rounded-xl bg-accent-indigo/10 border border-accent-indigo/20 flex items-center justify-center mx-auto mb-3">
                  <svg class="w-8 h-8 text-accent-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                  </svg>
                </div>
                <span class="text-text-muted text-sm">Article</span>
              </div>
            </div>
          </a>
        </div>
      )}

      <!-- Post grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {rest.map(post => (
          <a
            href={`/blog/${post.id}`}
            class="group rounded-xl border border-border bg-surface p-6 hover:border-accent-indigo/30 hover:bg-surface-2 transition-all"
          >
            <div class="flex items-center gap-2 mb-4">
              <Badge variant="default">{post.data.category}</Badge>
            </div>
            <h2 class="font-heading text-lg font-semibold text-text-primary mb-3 group-hover:text-accent-indigo transition-colors leading-snug">
              {post.data.title}
            </h2>
            <p class="text-text-secondary text-sm leading-relaxed mb-6 line-clamp-3">
              {post.data.description}
            </p>
            <div class="flex items-center justify-between text-xs text-text-muted">
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.readingTime && <span>{post.data.readingTime} min read</span>}
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-20 text-text-muted">
          <p>No posts yet. Check back soon.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
