---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Automation Agency for SMBs | Free Strategy Call | Mirai"
  description="Book a free 30-min strategy call with Mirai. We build AI voice agents, workflow automation, and chatbots for law firms, dental clinics, real estate, and e-commerce – deployed in under 1 week."
>
  <section class="relative py-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Left: Info -->
        <div>
          <div class="section-label mb-6">Contact</div>
          <h1 class="font-heading text-4xl sm:text-5xl font-bold text-text-primary mb-6 leading-tight">
            Let's talk about<br />your business.
          </h1>
          <p class="text-text-secondary text-lg leading-relaxed mb-10">
            Tell us what you're working on. We'll respond within 24 hours with honest thoughts on whether and how AI automation can help – and if it can, what that looks like in practice.
          </p>

          <!-- Contact details -->
          <div class="space-y-6 mb-10">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg border border-border bg-surface flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-text-muted text-xs mb-1">Email</p>
                <a href="mailto:hello@themiraitech.com" class="text-text-primary hover:text-accent-indigo transition-colors">
                  hello@themiraitech.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg border border-border bg-surface flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                </svg>
              </div>
              <div>
                <p class="text-text-muted text-xs mb-1">Prefer to talk first?</p>
                <p class="text-text-primary text-sm">
                  Use the form and mention your preferred time – we'll send a calendar invite with your reply.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg border border-border bg-surface flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-text-muted text-xs mb-1">Response time</p>
                <p class="text-text-primary text-sm">Within 24 hours on business days</p>
              </div>
            </div>
          </div>

          <!-- What to expect -->
          <div class="rounded-xl border border-border bg-surface p-6">
            <h3 class="font-heading text-sm font-semibold text-text-primary uppercase tracking-wider mb-4">
              What happens after you submit
            </h3>
            <ol class="space-y-3">
              {[
                'We review your submission and research your business type',
                'You get a personal reply (not a bot) within 24 hours',
                'If it\'s a fit, we schedule a 30-min strategy call',
                'On the call: we identify your best automation opportunity and give you a rough estimate',
                'You decide if you want to move forward – no pressure',
              ].map((step, i) => (
                <li class="flex items-start gap-3 text-sm text-text-secondary">
                  <span class="font-mono text-accent-indigo font-semibold flex-shrink-0 text-xs mt-0.5">
                    0{i + 1}
                  </span>
                  {step}
                </li>
              ))}
            </ol>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="rounded-xl border border-border bg-surface p-8">
          <h2 class="font-heading text-2xl font-bold text-text-primary mb-8">Send us a message</h2>

          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/contact/success"
            class="space-y-6"
          >
            <!-- Netlify hidden fields -->
            <input type="hidden" name="form-name" value="contact" />

            <!-- Honeypot -->
            <div style="display: none;" aria-hidden="true">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-text-secondary text-sm font-medium mb-2">
                  Full name <span class="text-red-400">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="John Smith"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-surface-2 text-text-primary placeholder-text-muted text-sm focus:outline-none focus:border-accent-indigo transition-colors"
                />
              </div>
              <div>
                <label for="email" class="block text-text-secondary text-sm font-medium mb-2">
                  Email <span class="text-red-400">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="john@company.com"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-surface-2 text-text-primary placeholder-text-muted text-sm focus:outline-none focus:border-accent-indigo transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="company" class="block text-text-secondary text-sm font-medium mb-2">
                  Company name
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  placeholder="Acme Inc."
                  class="w-full px-4 py-3 rounded-lg border border-border bg-surface-2 text-text-primary placeholder-text-muted text-sm focus:outline-none focus:border-accent-indigo transition-colors"
                />
              </div>
              <div>
                <label for="website" class="block text-text-secondary text-sm font-medium mb-2">
                  Website
                </label>
                <input
                  type="url"
                  id="website"
                  name="website"
                  placeholder="https://yoursite.com"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-surface-2 text-text-primary placeholder-text-muted text-sm focus:outline-none focus:border-accent-indigo transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="budget" class="block text-text-secondary text-sm font-medium mb-2">
                Approximate budget range
              </label>
              <select
                id="budget"
                name="budget"
                class="w-full px-4 py-3 rounded-lg border border-border bg-surface-2 text-text-primary text-sm focus:outline-none focus:border-accent-indigo transition-colors"
              >
                <option value="" disabled selected>Select a range...</option>
                <option value="under-3k">Under $3,000</option>
                <option value="3k-8k">$3,000 – $8,000</option>
                <option value="8k-15k">$8,000 – $15,000</option>
                <option value="15k-30k">$15,000 – $30,000</option>
                <option value="30k-plus">$30,000+</option>
                <option value="not-sure">Not sure yet</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-text-secondary text-sm font-medium mb-2">
                What are you looking to automate? <span class="text-red-400">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Tell us about your business, the problem you're trying to solve, and any tools you're currently using..."
                class="w-full px-4 py-3 rounded-lg border border-border bg-surface-2 text-text-primary placeholder-text-muted text-sm focus:outline-none focus:border-accent-indigo transition-colors resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="btn-primary w-full justify-center text-base py-4"
            >
              Send message
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </button>

            <p class="text-text-muted text-xs text-center">
              By submitting, you agree to our <a href="/privacy" class="underline hover:text-text-secondary">Privacy Policy</a>. We don't spam.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Take over form submission so we control both Netlify Forms capture
  // AND the /api/lead call AND the redirect – avoiding the double-redirect 404.
  function setupContactForm() {
    const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
    if (!form || form.dataset.jsHandled) return;
    form.dataset.jsHandled = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = form.querySelector<HTMLButtonElement>('[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

      const fd = new FormData(form);

      // 1. Save to Netlify Forms via fetch (no redirect, just data capture)
      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(fd as any).toString(),
      }).catch(() => {});

      // 2. Send structured notification to WhatsApp
      const payload = JSON.stringify({
        source: 'contact-form',
        name: fd.get('name'),
        email: fd.get('email'),
        company: fd.get('company'),
        website: fd.get('website'),
        budget: fd.get('budget'),
        message: fd.get('message'),
      });

      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/lead', new Blob([payload], { type: 'application/json' }));
      } else {
        fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
        }).catch(() => {});
      }

      // 3. Redirect ourselves – no Netlify redirect chain involved
      window.location.href = '/contact/success';
    });
  }

  // Runs on initial load and after View Transitions navigations
  document.addEventListener('DOMContentLoaded', setupContactForm);
  document.addEventListener('astro:page-load', setupContactForm);
</script>
