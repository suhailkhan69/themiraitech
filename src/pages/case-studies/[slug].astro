---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import CTA from '@/components/sections/CTA.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map(study => ({
    params: { slug: study.id },
    props: { study },
  }));
}

interface Props {
  study: CollectionEntry<'case-studies'>;
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout
  title={`${study.data.client} Case Study | Mirai`}
  description={`${study.data.result} — See how Mirai helped ${study.data.client} with AI automation.`}
>
  <!-- Breadcrumb -->
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8">
    <ol class="flex items-center gap-2 text-sm text-text-muted">
      <li><a href="/" class="hover:text-text-primary transition-colors">Home</a></li>
      <li>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li><a href="/case-studies" class="hover:text-text-primary transition-colors">Case Studies</a></li>
      <li>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </li>
      <li class="text-text-primary">{study.data.client}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="relative py-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <Badge variant="accent">{study.data.industry}</Badge>
          {study.data.services.map(s => (
            <Badge variant="default">{s}</Badge>
          ))}
        </div>
        <h1 class="font-heading text-4xl sm:text-5xl font-bold text-text-primary mb-6 leading-tight">
          {study.data.title}
        </h1>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12">
      <!-- Main -->
      <div>
        <!-- Metrics bar -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 p-6 rounded-xl border border-border bg-surface">
          {study.data.metrics.map(m => (
            <div class="text-center">
              <div class="stat-number text-3xl text-accent-indigo mb-1">{m.value}</div>
              <div class="text-text-muted text-xs">{m.label}</div>
              {m.change && <div class="text-emerald-400 text-xs font-mono">{m.change}</div>}
            </div>
          ))}
        </div>

        <!-- Content -->
        <div class="prose prose-invert prose-lg max-w-none">
          <Content />
        </div>

        <!-- Testimonial -->
        {study.data.testimonial && (
          <div class="mt-12 rounded-xl border border-accent-indigo/20 bg-accent-indigo/5 p-8">
            <svg class="w-8 h-8 text-accent-indigo/40 mb-4" fill="currentColor" viewBox="0 0 32 32">
              <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"/>
            </svg>
            <blockquote class="text-text-primary text-lg font-medium leading-relaxed mb-4 italic">
              "{study.data.testimonial.quote}"
            </blockquote>
            <cite class="text-text-muted text-sm not-italic">
              — {study.data.testimonial.author}, {study.data.testimonial.role}
            </cite>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="sticky top-24 space-y-6">
          <!-- Client overview -->
          <div class="rounded-xl border border-border bg-surface p-6">
            <h3 class="font-heading text-sm font-semibold text-text-primary uppercase tracking-wider mb-4">
              Client overview
            </h3>
            <dl class="space-y-3">
              <div>
                <dt class="text-text-muted text-xs">Company</dt>
                <dd class="text-text-primary text-sm font-medium">{study.data.client}</dd>
              </div>
              <div>
                <dt class="text-text-muted text-xs">Industry</dt>
                <dd class="text-text-primary text-sm">{study.data.industry}</dd>
              </div>
              <div>
                <dt class="text-text-muted text-xs">Services used</dt>
                <dd class="flex flex-wrap gap-1 mt-1">
                  {study.data.services.map(s => (
                    <span class="text-xs border border-border px-2 py-0.5 rounded-full text-text-secondary">{s}</span>
                  ))}
                </dd>
              </div>
            </dl>
          </div>

          <!-- Key result -->
          <div class="rounded-xl border border-accent-indigo/20 bg-accent-indigo/5 p-6 text-center">
            <p class="text-text-muted text-xs uppercase tracking-wider mb-2">Key result</p>
            <p class="font-mono text-3xl font-bold text-accent-indigo mb-1">
              {study.data.metrics[0]?.value}
            </p>
            <p class="text-text-secondary text-sm">{study.data.metrics[0]?.label}</p>
          </div>

          <!-- CTA -->
          <div class="rounded-xl border border-border bg-surface p-6 text-center">
            <p class="font-heading font-semibold text-text-primary mb-2 text-sm">Want similar results?</p>
            <p class="text-text-secondary text-xs mb-4">
              Book a free strategy call to see how we can automate your business.
            </p>
            <a href="/contact" class="btn-primary w-full justify-center text-sm">
              Book a call
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <CTA
    headline="Ready to see results like these?"
    subhead="Book a free 30-minute strategy call. We'll identify the highest-leverage automation opportunity for your specific business."
  />
</BaseLayout>
