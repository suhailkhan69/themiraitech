---
import SolutionLayout from '@/layouts/SolutionLayout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What e-commerce tasks can AI automate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI can automate customer support (order tracking, returns, FAQs), abandoned cart recovery, inventory management alerts, review request emails, shipping notifications, and personalized product recommendations – typically saving 10+ hours per week."
      }
    },
    {
      "@type": "Question",
      "name": "How does AI reduce e-commerce customer support costs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI chatbots handle 70-80% of routine support tickets – order status, return policies, product questions – automatically. This reduces support labor costs by 15-20% and provides 24/7 coverage without additional headcount."
      }
    },
    {
      "@type": "Question",
      "name": "Does AI automation work with Shopify or WooCommerce?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Mirai builds AI systems that integrate natively with Shopify, WooCommerce, BigCommerce, Magento, and other major e-commerce platforms – pulling real-time order data to give customers accurate, instant answers."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to deploy AI automation for my e-commerce store?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most e-commerce AI automations go live within 3-5 days. A Shopify-integrated support chatbot with order tracking and FAQ handling can be live in as little as 48 hours after the strategy call."
      }
    }
  ]
};
---

<SolutionLayout
  industry="E-commerce"
  tagline="AI support and automation that scales with your sales."
  description="Deflect 80% of support tickets, automate order workflows, and recover abandoned carts – without scaling your team proportionally."
  title="AI Automation for E-commerce Brands | US, UK, Canada, Australia | Mirai"
  seoDescription="AI automation for e-commerce brands in the US, UK, Canada & Australia. Deflect 80% of support tickets, automate order workflows & recover abandoned carts with custom AI."
  pageUrl="https://themiraitech.com/solutions/ecommerce"
  painPoints={[
    "Support volume scaling linearly with revenue – hiring 1 new agent per $500k in sales",
    "Same questions answered manually hundreds of times per day ('Where is my order?')",
    "Abandoned carts with no automated recovery beyond a single email",
    "Manual order processing and inventory update workflows across multiple tools",
    "No personalized product recommendation system",
    "Returns and refunds processed manually, slowing turnaround",
  ]}
  useCases={[
    {
      title: 'AI Customer Support Chatbot',
      description: 'Trained on your product catalog, policies, and FAQs. Handles order tracking, return initiation, product questions, and size guidance – resolving 80% of tickets without a human.',
      stat: '80% ticket deflection rate',
    },
    {
      title: 'Abandoned Cart Recovery',
      description: 'Multi-channel recovery sequences (email + SMS) powered by AI personalization – different messaging for high-intent vs. price-sensitive abandoners, with smart discount logic.',
      stat: 'Average 18% recovery rate',
    },
    {
      title: 'Order & Inventory Automation',
      description: 'Connects Shopify/WooCommerce to your 3PL, supplier, and accounting tools. Auto-updates inventory, triggers reorder alerts, and syncs order status across systems.',
      stat: '6hrs/day of manual work eliminated',
    },
    {
      title: 'Post-Purchase Sequences',
      description: 'Automated review requests, upsell recommendations, and loyalty program communications timed perfectly to the customer lifecycle.',
      stat: '+22% repeat purchase rate',
    },
  ]}
  schema={faqSchema}
/>
