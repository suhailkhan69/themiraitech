---
import SolutionLayout from '@/layouts/SolutionLayout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How can AI automation help my law firm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI automation for law firms handles intake calls, qualifies leads, generates documents, and manages client communications — reducing intake time from 45 minutes to under 8 minutes and saving paralegals 3+ hours daily."
      }
    },
    {
      "@type": "Question",
      "name": "How much does AI automation cost for a law firm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI automation for law firms starts at $3,000 for a single workflow (e.g. document automation), and $8,000–$15,000 for a full AI intake agent system. Every project starts with a free strategy call and fixed-price quote."
      }
    },
    {
      "@type": "Question",
      "name": "Does AI automation work with Clio, MyCase, or other legal software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Mirai integrates AI automation directly with Clio, MyCase, PracticePanther, Smokeball, and most legal practice management systems. No disruption to your existing workflows."
      }
    },
    {
      "@type": "Question",
      "name": "Is AI automation for law firms HIPAA or data-compliant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All data is encrypted in transit and at rest. We sign NDAs before every engagement and build on SOC 2-compliant infrastructure. For regulated legal matters, we design specifically for your jurisdiction's compliance requirements."
      }
    }
  ]
};
---

<SolutionLayout
  industry="Legal Firms"
  tagline="Intake more clients without hiring more staff."
  description="We build AI intake agents, document automation, and client communication systems for law firms — reducing intake time by 82% and capturing more qualified consultations."
  title="AI Automation for Law Firms & Legal Practices | US, UK, Canada, Australia | Mirai"
  seoDescription="AI automation for law firms in the US, UK, Canada & Australia. AI intake agents, document automation & client communication that cut intake time by 82% and capture more consultations."
  pageUrl="https://themiraitech.com/solutions/legal"
  painPoints={[
    "Intake calls taking 45+ minutes per potential client, most of whom don't convert",
    "Paralegals spending hours on repetitive document drafting",
    "Missed calls from potential clients who call competitors instead",
    "Client communication bottlenecks delaying case progress",
    "Inconsistent intake qualification — taking unqualified cases",
    "Manual billing tracking and time entry errors",
  ]}
  useCases={[
    {
      title: 'AI Intake Agent',
      description: 'Handles initial intake calls — collects case details, assesses case viability based on your practice areas, and books consultations only for qualified prospects. Captures information in your case management software automatically.',
      stat: '45-min intake → 8 minutes',
    },
    {
      title: 'Document Automation',
      description: 'Auto-generates client letters, retainer agreements, intake forms, and status updates from templates. Lawyers review and sign — they don\'t draft from scratch.',
      stat: '3hrs/day saved per paralegal',
    },
    {
      title: 'Client Communication Hub',
      description: 'AI handles routine client inquiries ("What\'s the status of my case?"), sends automated updates at case milestones, and escalates complex questions to attorneys.',
      stat: '70% fewer status-inquiry calls',
    },
    {
      title: 'After-Hours Coverage',
      description: 'An AI agent that answers calls at night and on weekends — qualifies the matter, gathers details, and schedules a consultation. No more missed emergency inquiries.',
      stat: '24/7 availability',
    },
  ]}
  caseStudyRef={{
    title: 'Acme Law: Intake time reduced 82%, 40% more consultations booked',
    result: '82% faster intake',
    href: '/case-studies/acme-law',
  }}
  schema={faqSchema}
/>
