---
import SolutionLayout from '@/layouts/SolutionLayout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does AI help real estate agencies generate more leads?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI chatbots on your website engage visitors 24/7, qualify them with questions about budget, timeline, and location, then book them directly into agent calendars – converting 3x more website visitors into booked consultations."
      }
    },
    {
      "@type": "Question",
      "name": "Can AI follow up with real estate leads automatically?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Mirai builds automated lead nurturing sequences that follow up via SMS, email, and voice within minutes of a lead inquiry – keeping your agency top of mind while agents focus on active clients."
      }
    },
    {
      "@type": "Question",
      "name": "Does AI real estate automation integrate with my CRM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Mirai integrates with Follow Up Boss, HubSpot, GoHighLevel, Salesforce, LionDesk, and most real estate CRMs. Leads flow automatically from your website into your CRM with full qualification data."
      }
    },
    {
      "@type": "Question",
      "name": "How quickly can AI lead generation be deployed for my agency?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most real estate AI systems go live within 3-5 days. The AI chatbot is trained on your listings, FAQs, and qualification criteria – then deployed on your website. No technical work required from your team."
      }
    }
  ]
};
---

<SolutionLayout
  industry="Real Estate"
  tagline="Fill your calendar without an SDR team."
  description="We build AI voice agents and lead automation systems specifically for real estate brokerages – qualifying buyers, booking showings, and nurturing leads 24/7 without adding headcount."
  title="AI Automation for Real Estate Agencies & Brokerages | US, UK, Canada, Australia | Mirai"
  seoDescription="AI automation for real estate agencies in the US, UK, Canada & Australia. AI voice agents that qualify buyers, book showings & nurture leads 24/7. 342% more qualified leads."
  pageUrl="https://themiraitech.com/solutions/real-estate"
  painPoints={[
    "Missing calls from motivated buyers and sellers while you're on a showing",
    "Spending hours manually following up with cold leads that go nowhere",
    "Paying $5k+/month for appointment setters who have inconsistent quality",
    "Losing listings to competitors who respond faster",
    "Drowning in admin – data entry, CRM updates, email follow-ups",
    "No way to work inbound leads at 9pm when motivated buyers are searching",
  ]}
  useCases={[
    {
      title: 'AI Inbound Call Agent',
      description: 'Qualifies every inbound lead with a natural conversation – budget, timeline, location preferences, pre-approval status – and books a call with your agent directly into your calendar.',
      stat: 'Handles 200+ calls/month without human help',
    },
    {
      title: 'Showing Booking Automation',
      description: 'Connects to your MLS listings and calendar. Qualified buyers can book, reschedule, or cancel showings automatically. Sends confirmation texts and reminders to reduce no-shows.',
      stat: '60% fewer no-shows',
    },
    {
      title: 'Lead Nurture Sequences',
      description: 'Automated email + SMS sequences for leads who aren\'t ready to transact yet. AI personalizes messages based on property searches, price range, and previous interactions.',
      stat: 'Average 4.2× ROI on long-term nurture',
    },
    {
      title: 'CRM Automation',
      description: 'Every call, showing, and interaction automatically logged to your CRM (Follow Up Boss, KVCore, HubSpot). Never lose a lead to a missed update again.',
      stat: '100% lead capture rate',
    },
  ]}
  caseStudyRef={{
    title: 'Vertex Realty: 342% more qualified leads, $96k saved annually',
    result: '342% more qualified leads',
    href: '/case-studies/vertex-realty',
  }}
  schema={faqSchema}
/>
