---
import SolutionLayout from '@/layouts/SolutionLayout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How can AI help home services businesses book more jobs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI voice agents answer every call – even after hours and on weekends – qualify the service request, check availability, and book the job directly into your calendar. Home services businesses capture 40% more leads this way."
      }
    },
    {
      "@type": "Question",
      "name": "Can AI send automated booking confirmations and reminders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. After booking, AI sends confirmation texts and emails automatically, then reminder messages 24 hours and 2 hours before the appointment – reducing no-shows by up to 60% with zero manual effort."
      }
    },
    {
      "@type": "Question",
      "name": "Does AI scheduling work for plumbers, HVAC, landscaping, and cleaning companies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Mirai builds AI scheduling systems for all home services trades – plumbing, HVAC, electrical, landscaping, cleaning, pest control, and more. The system is trained on your services, pricing, and availability rules."
      }
    },
    {
      "@type": "Question",
      "name": "What CRM and scheduling tools does AI home services automation integrate with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mirai integrates with ServiceTitan, Jobber, HouseCall Pro, GoHighLevel, Housecall, and most field service management tools – so all bookings flow directly into your existing system."
      }
    }
  ]
};
---

<SolutionLayout
  industry="Home Services"
  tagline="Win more jobs while you're on the job."
  description="AI voice agents and booking automation for HVAC, plumbing, electrical, landscaping, and cleaning companies – so you stop losing work to voicemail."
  title="AI Automation for Home Services Companies | US, UK, Canada, Australia | Mirai"
  seoDescription="AI automation for home services businesses in the US, UK, Canada & Australia. AI voice agents for HVAC, plumbing, electrical & cleaning that answer calls and book estimates 24/7."
  pageUrl="https://themiraitech.com/solutions/home-services"
  painPoints={[
    "Missing calls from homeowners with urgent problems while your team is on a job",
    "Competitors who answer faster winning the work you should be getting",
    "Quoting and follow-up falling through the cracks with a field-heavy team",
    "Seasonal demand spikes overwhelming your booking capacity",
    "Manual scheduling creating routing inefficiencies and technician downtime",
    "No systematic review collection process despite satisfied customers",
  ]}
  useCases={[
    {
      title: 'AI Inbound Call Agent',
      description: 'Answers every call immediately – collects the job details, qualifies the request, checks your calendar, and books an estimate or service appointment on the spot.',
      stat: '40% more booked jobs',
    },
    {
      title: 'Quote Follow-Up Automation',
      description: 'When a quote goes out, an automated sequence follows up at 24hrs, 3 days, and 7 days via text and email. Homeowners can accept, decline, or ask questions by replying.',
      stat: '35% quote-to-job conversion lift',
    },
    {
      title: 'Job Scheduling & Dispatch',
      description: 'AI connects to your scheduling software and optimizes technician routing based on location and job type. New bookings are auto-routed to the right tech with the right skills.',
      stat: '25% more jobs per tech per day',
    },
    {
      title: 'Review Generation System',
      description: 'After every completed job, an automated text asks for a Google review. Happy customers are prompted to share; unhappy customers are routed to your team first.',
      stat: '5× more Google reviews collected',
    },
  ]}
  schema={faqSchema}
/>
