---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/sections/CTA.astro';

const values = [
  {
    title: 'We ship, not slide.',
    description: 'Strategy decks don\'t automate your business. We bias heavily toward building fast and iterating based on real data. Most agencies over-plan; we over-build.',
  },
  {
    title: 'We\'re honest about fit.',
    description: 'If AI automation isn\'t right for your business right now, we\'ll tell you that in the strategy call. We don\'t optimize for closing deals – we optimize for long-term client relationships.',
  },
  {
    title: 'We treat your business like ours.',
    description: 'We only work with a small number of clients at a time so we can go deep. When we build your system, it has our full attention – not split across 50 other accounts.',
  },
];

const differentiators = [
  { label: 'Industry-specific expertise', description: 'We\'ve built systems for 10+ business types and know the workflows, compliance requirements, and tools specific to each.' },
  { label: 'Fixed-price quotes', description: 'No hourly billing surprises. Every project gets a fixed price upfront based on defined scope.' },
  { label: 'Deployment-first approach', description: 'We skip the endless discovery phase. Our process goes from strategy call to live system in as little as 1 week.' },
  { label: 'Post-launch support', description: '30 days of support included with every project. Your system keeps improving after launch, not just at launch.' },
  { label: 'Small team, direct access', description: 'You work with the same people who build your system – not a PM who relays messages to offshore developers.' },
  { label: 'Western market focus', description: 'We specifically serve US, UK, Canadian, and Australian businesses. We understand your market, your regulations, and your tools.' },
];
---

<BaseLayout
  title="About Mirai – AI Automation Agency | US, UK, Canada, Australia"
  description="Mirai is an AI automation agency that builds production-ready AI systems for SMBs in the US, UK, Canada, and Australia. We ship in days, not months."
>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-hero pointer-events-none"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="section-label mb-4">About</div>
        <h1 class="font-heading text-5xl sm:text-6xl font-bold text-text-primary mb-6 leading-tight">
          We built the agency<br />we wish existed.
        </h1>
        <p class="text-text-secondary text-xl leading-relaxed">
          Mirai was founded on a simple observation: most SMBs know AI can help them, but they can't find an agency that moves fast, charges fairly, and actually ships working systems.
        </p>
      </div>
    </div>
  </section>

  <!-- Founder section -->
  <section class="py-20 bg-surface border-y border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Founder card -->
        <div class="rounded-xl border border-border bg-background p-8">
          <div class="flex items-start gap-6 mb-6">
            <div class="w-20 h-20 rounded-xl overflow-hidden flex-shrink-0 border border-border">
              <img
                src="/founder.jpg"
                alt="Suhail Khan, Founder of Mirai"
                class="w-full h-full object-cover object-top"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
              />
              <div class="w-full h-full bg-gradient-primary items-center justify-center hidden">
                <span class="text-white font-bold text-2xl font-heading">S</span>
              </div>
            </div>
            <div>
              <h2 class="font-heading text-xl font-bold text-text-primary">Suhail Khan</h2>
              <p class="text-accent-cyan text-sm">Founder & CEO, Mirai</p>
              <div class="flex items-center gap-2 mt-2">
                <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-primary transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
          <div class="space-y-4 text-text-secondary text-sm leading-relaxed">
            <p>
              I started Mirai after watching the same story play out over and over: small business owners drowning in repetitive work – missed calls, manual follow-ups, copy-paste admin – while the AI tools that could fix all of it sat just out of reach, locked behind enterprise pricing and technical complexity.
            </p>
            <p>
              The technology was never the problem. Implementation was. So I built the agency I wished existed: one that scopes honestly, builds fast, and ships production systems – not pilot programs and strategy decks.
            </p>
            <p>
              Mirai is named after the Japanese word for "future" – because I believe every SMB deserves access to the kind of AI systems that were, until recently, only available to companies with 7-figure technology budgets.
            </p>
          </div>
        </div>

        <!-- Story text -->
        <div>
          <h2 class="font-heading text-3xl font-bold text-text-primary mb-6">
            Why we exist
          </h2>
          <div class="space-y-4 text-text-secondary leading-relaxed">
            <p>
              Every week, we talk to business owners who are stuck: they know AI automation would help them grow, but they've been burned by agencies that overpromise and underdeliver, or they've tried off-the-shelf tools that don't fit their workflow.
            </p>
            <p>
              The specific problem isn't access to the technology – AI has never been more accessible. The problem is implementation. Taking a capable AI model and building it into a production system that actually works inside your specific business, with your specific tools, for your specific customers, requires expertise that most agencies don't have.
            </p>
            <p>
              We built Mirai to be the agency that actually ships. Small team, deep expertise, honest pricing, fast timelines.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="section-label mb-4">Values</div>
        <h2 class="font-heading text-4xl font-bold text-text-primary">How we work</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {values.map(v => (
          <div class="rounded-xl border border-border bg-surface p-8">
            <h3 class="font-heading text-xl font-semibold text-text-primary mb-4">{v.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Mirai -->
  <section class="py-20 bg-surface border-y border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="section-label mb-4">Differentiators</div>
        <h2 class="font-heading text-4xl font-bold text-text-primary">Why Mirai</h2>
        <p class="text-text-secondary text-lg mt-4 max-w-xl mx-auto">
          What makes us different from the dozens of "AI agencies" that appeared in 2024.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {differentiators.map(d => (
          <div class="rounded-xl border border-border bg-background p-6">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-5 h-5 rounded-full bg-accent-indigo/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-accent-indigo" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="font-heading text-base font-semibold text-text-primary">{d.label}</h3>
            </div>
            <p class="text-text-secondary text-sm leading-relaxed pl-8">{d.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team section -->
  <section class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="section-label mb-4">Team</div>
        <h2 class="font-heading text-4xl font-bold text-text-primary">The people building your system</h2>
      </div>
      <div class="max-w-2xl mx-auto">
        <div class="rounded-2xl border border-border bg-surface p-8 sm:p-10 text-center">
          <div class="w-20 h-20 rounded-2xl overflow-hidden mx-auto mb-5 border border-border">
            <img
              src="/founder.jpg"
              alt="Suhail Khan"
              class="w-full h-full object-cover object-top"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            />
            <div class="w-full h-full bg-gradient-primary items-center justify-center hidden rounded-2xl">
              <span class="text-white font-bold text-2xl">S</span>
            </div>
          </div>
          <h3 class="font-heading text-xl font-semibold text-text-primary mb-1">Suhail Khan</h3>
          <p class="text-accent-cyan text-sm mb-6">Founder & CEO</p>
          <p class="text-text-secondary text-sm leading-relaxed max-w-lg mx-auto">
            Mirai is deliberately founder-led. When you work with us, you work directly with
            the person who scopes, designs, and is accountable for your system – backed by a
            network of specialist engineers brought in per project. No account managers,
            no handoffs, no telephone game between sales and delivery.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTA
    headline="Work with us"
    subhead="We take on a limited number of new clients each quarter. If you're interested in working together, book a call and let's see if we're a fit."
    primaryLabel="Book a strategy call"
    secondaryLabel="View our services"
    secondaryHref="/services"
  />
</BaseLayout>
