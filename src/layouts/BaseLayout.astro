---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ChatWidget from '@/components/ChatWidget';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Mirai builds AI voice agents, workflow automation, and custom AI systems for law firms, dental clinics, real estate agencies, and e-commerce brands in the US, UK, Canada, and Australia.',
  ogImage = '/og-default.png',
  canonicalURL: rawCanonical = Astro.url.href,
  noindex = false,
  schema,
} = Astro.props;

// Always use canonical URLs without trailing slash (except root)
const canonicalURL = rawCanonical === 'https://themiraitech.com/'
  ? rawCanonical
  : rawCanonical.replace(/\/$/, '');

const siteTitle = title.includes('Mirai') ? title : `${title} | Mirai`;

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://themiraitech.com/#website",
      "url": "https://themiraitech.com",
      "name": "Mirai",
      "description": "AI automation agency for SMBs in the US, UK, Canada, and Australia",
      "inLanguage": "en-US",
      "publisher": { "@id": "https://themiraitech.com/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://themiraitech.com/blog?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": "https://themiraitech.com/#organization",
      "name": "Mirai",
      "alternateName": "mirAi Tech",
      "url": "https://themiraitech.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://themiraitech.com/logo.svg",
        "width": 200,
        "height": 60
      },
      "description": "AI automation agency specializing in AI voice agents, workflow automation, custom AI chatbots, and AI lead generation for law firms, real estate agencies, dental clinics, e-commerce brands, and home services companies across the US, UK, Canada, and Australia.",
      "foundingDate": "2024",
      "priceRange": "$$$",
      "knowsAbout": [
        "AI voice agents",
        "workflow automation",
        "RAG chatbots",
        "AI lead generation",
        "n8n automation",
        "Make automation",
        "CRM automation",
        "business process automation",
        "dental clinic AI",
        "law firm AI",
        "real estate AI automation"
      ],
      "areaServed": [
        { "@type": "Country", "name": "United States" },
        { "@type": "Country", "name": "United Kingdom" },
        { "@type": "Country", "name": "Canada" },
        { "@type": "Country", "name": "Australia" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AI Automation Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AI Voice Agents",
              "url": "https://themiraitech.com/services#voice-agents",
              "description": "24/7 AI phone agents that handle inbound calls, qualify leads, and book appointments for SMBs."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Workflow Automation",
              "url": "https://themiraitech.com/services#workflow-automation",
              "description": "End-to-end automation of repetitive business tasks using n8n, Make, and custom APIs."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AI Chatbots & RAG Systems",
              "url": "https://themiraitech.com/services#chatbots",
              "description": "Custom AI chatbots trained on your business documents, deployed on your website or WhatsApp."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AI Lead Generation",
              "url": "https://themiraitech.com/services#lead-generation",
              "description": "AI-powered outreach systems that identify, contact, and qualify prospects automatically."
            }
          }
        ]
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "url": "https://themiraitech.com/contact",
        "availableLanguage": ["English"]
      },
      "sameAs": [
        "https://linkedin.com/company/themiraitech",
        "https://twitter.com/themiraitech"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="Mirai" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="OyTpszWUEZKWAlGEwD4edLv7YlSvVZo-GhuSbQOIgSs" />

    <!-- Google Analytics GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-60ZVE51E95"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-60ZVE51E95');
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Schema.org site-wide graph -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <!-- Page-specific Schema.org -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 pt-16">
      <slot />
    </main>
    <Footer />
    <ChatWidget client:idle />
  </body>
</html>
